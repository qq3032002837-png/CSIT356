{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3893119faf2d434d896079dbf198ba6d",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ReconstructWorldPosition (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 56.500022888183597,
            "y": 188.49996948242188,
            "width": 300.4999084472656,
            "height": 101.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "b83fcfc998814bb39ea92fef722ddcba"
        },
        {
            "m_Id": "a1ae59c6580d47fa975722bc02114b0e"
        },
        {
            "m_Id": "2e9a38c1999b41508bc524b1b1b20e63"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ReconstructWorldPosition",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if SHADERGRAPH_PREVIEW\n    WorldPos = float3(0, 0, 0);\n#else\n    float depth = RawDepth;\n\n    #if !UNITY_REVERSED_Z\n        depth = lerp(UNITY_NEAR_CLIP_VALUE, 1.0, depth);\n    #endif\n\n    WorldPos = ComputeWorldSpacePosition(\n        UV,\n        depth,\n        UNITY_MATRIX_I_VP\n    );\n#endif"
}

